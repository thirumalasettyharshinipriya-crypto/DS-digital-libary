# =====================================================================
# DS LAB PORTAL — ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure with your local settings.
# =====================================================================

# Server Port
PORT=3000
FLASK_PORT=5000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ds_lab
DB_USER=dslab_user
DB_PASSWORD=your_secure_password_here
DB_POOL_SIZE=5

# Application Secret Key
SECRET_KEY=change_this_to_a_random_secret_in_production

# Upload Settings
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads

# Optional Sandbox Execution Settings
ENABLE_CODE_SANDBOX=true
SANDBOX_TIMEOUT_SECONDS=5
